EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Production API URL is baked into eas.json per-profile.
# Override here only for local development.
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── EAS Secrets (CI / cloud builds) ───────────────────────────────────────
# EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY must be stored
# as EAS project secrets so they are injected during cloud builds without
# being committed to git.
#
# Set them once via the EAS CLI:
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value <url>
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <key>
#
# EXPO_PUBLIC_API_URL is already baked into eas.json (preview / production /
# huawei profiles) as it points to the public Railway backend URL.
