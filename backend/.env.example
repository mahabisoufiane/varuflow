# File: .env.example
# Purpose: Template for local .env — copy to .env and fill in real values
# Used by: local development (docker compose), never committed with real values

# PostgreSQL — asyncpg driver required. Railway/Supabase supply postgresql://, add +asyncpg manually.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Comma-separated origins — NO JSON brackets, NO spaces around commas
# Local:       CORS_ORIGINS=http://localhost:3000
# Production:  CORS_ORIGINS=https://varuflow.vercel.app
# Both:        CORS_ORIGINS=https://varuflow.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Fernet key (urlsafe base64) for encrypting Fortnox OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FORTNOX_ENCRYPTION_KEY=
# Must match the Railway deployment URL exactly.
FORTNOX_REDIRECT_URI=
OPENAI_API_KEY=
PORTAL_JWT_SECRET=change-me-to-32-random-chars-in-prod
# Fernet key for encrypting PII columns (customer email/phone/address, TOTP secrets).
# Required in production — startup refuses to boot without it.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
PORTAL_BASE_URL=https://varuflow.vercel.app
FRONTEND_URL=https://varuflow.vercel.app
# Calendly booking links for NPS follow-up and retention emails
CALENDLY_DETRACTOR_URL=https://calendly.com/varuflow/feedback
CALENDLY_CSM_URL=https://calendly.com/varuflow/success
CALENDLY_FOUNDER_URL=https://calendly.com/varuflow/founders
SENTRY_DSN=
ENV=development
DEBUG=true

# ── Security hardening toggles ─────────────────────────────────────────────
# Production MUST keep both of these True. Override to False only in a local
# .env when running without a Supabase project (see middleware/auth.py).
ENFORCE_JWT_SIGNATURE=false
ENFORCE_SECRET_VALIDATION=false

# Defense-in-depth for the unauthenticated dev user. Must be True AND
# ENV=development for the bypass to open. Leave False on Railway/Vercel.
ALLOW_DEV_BYPASS=true

# Read-only maintenance mode. When True, non-safe HTTP methods return 503.
# Flip to True in Railway Variables during DB restore / maintenance windows.
READONLY_MODE=false

# ── Standalone local auth ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=change-me-use-64-char-random-hex-in-production

# SMTP — leave SMTP_HOST blank to print emails to stdout in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@varuflow.se

# Admin API — shared secret for admin-only endpoints (waitlist list/export).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable all admin endpoints.
ADMIN_API_KEY=

# ── nShift / Unifaun shipping gateway ──────────────────────────────────────
# Covers PostNord, DHL, UPS via a single integration.
# Leave empty to disable real label generation (tracking stored manually).
NSHIFT_API_KEY=
NSHIFT_API_SECRET=
NSHIFT_SENDER_ID=

# ── Storefront Stripe webhook ──────────────────────────────────────────────
# Separate webhook secret for /api/shop/webhooks/stripe.
STRIPE_STOREFRONT_WEBHOOK_SECRET=
