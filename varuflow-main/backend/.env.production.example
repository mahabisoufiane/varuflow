# ============================================================
# Varuflow — Production Environment Variables
# Copy this file to Railway → Project → Variables
# Never commit real values to git.
#
# Generate secrets:
#   token:  python -c "import secrets; print(secrets.token_hex(32))"
#   fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================

# ── Core ────────────────────────────────────────────────────
ENV=production
DEBUG=false
TRUST_PROXY=true
ALLOW_DEV_BYPASS=false
ENFORCE_JWT_SIGNATURE=true
ENFORCE_SECRET_VALIDATION=true
READONLY_MODE=false

# ── Database ────────────────────────────────────────────────
# Railway auto-injects this when you add a Postgres service
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/varuflow

# ── Supabase ────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role key — never the anon key
SUPABASE_JWT_SECRET=                   # JWT secret from Supabase → Settings → API

# ── JWT Secrets ─────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(64))"
AUTH_JWT_SECRET=
# python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_JWT_SECRET=

# ── Encryption ──────────────────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_PREVIOUS=           # set during key rotation only, then clear

# ── Admin ───────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=
ADMIN_API_KEY_PREVIOUS=                # set during key rotation only, then clear

# ── CORS ────────────────────────────────────────────────────
# Comma-separated — no wildcard allowed
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── URLs ────────────────────────────────────────────────────
PORTAL_BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Stripe ──────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STOREFRONT_WEBHOOK_SECRET=whsec_...
# Dashboard → Products → your plan → Price ID
STRIPE_PRO_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...

# ── Email ───────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_...
SMTP_FROM=noreply@yourdomain.com

# ── Error Tracking ──────────────────────────────────────────
# sentry.io → Project → Settings → Client Keys
SENTRY_DSN=https://...@sentry.io/...

# ── Redis (required before scaling past 1 Railway replica) ──
# Railway Add-ons → Redis → Connection string (use rediss:// for TLS)
REDIS_URL=rediss://:password@host:6379/0

# ── Fortnox (optional — Swedish accounting integration) ──────
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=https://your-backend.railway.app/api/integrations/fortnox/callback
# Required if Fortnox credentials above are set:
FORTNOX_ENCRYPTION_KEY=

# ── BankID (optional — Swedish e-ID) ────────────────────────
# Production cert from Finansiell ID-Teknik BID AB (bankid.com/en/utvecklare)
BANKID_API_URL=https://appapi2.bankid.com/rp/v6.0
BANKID_CLIENT_CERT_PATH=/secrets/bankid-cert.pem
BANKID_CA_CERT_PATH=/secrets/bankid-ca.pem

# ── Optional integrations ────────────────────────────────────
OPENAI_API_KEY=
OPEN_EXCHANGE_RATES_API_KEY=
BOLAGSVERKET_API_URL=
BOLAGSVERKET_API_TOKEN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── WhatsApp / SMS (optional) ────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM_NUMBER=

# ── Shipping / nShift (optional) ────────────────────────────
NSHIFT_API_KEY=
NSHIFT_API_SECRET=
NSHIFT_SENDER_ID=
