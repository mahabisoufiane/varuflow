# studio/.env — required for `npm run seed`
# Copy to studio/.env and fill in your values.
# Get these from https://sanity.io/manage → your project → API

SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# Create a write token: sanity.io/manage → API → Tokens → Add API token (Editor role)
SANITY_AUTH_TOKEN=your-editor-token

# Studio env var (separate — used by the Studio UI itself)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
